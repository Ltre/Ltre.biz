{
  "name": "generic-ai-relay-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply AI_RELAY_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply AI_RELAY_DB --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/providers.js && node --check src/security.js && node --check public/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.79.0"
  }
}
